{
	"schemaVersion": "0.1.0",
	"name": "YouTube with transcript",
	"behavior": "create",
	"noteContentFormat": "![{{schema:@VideoObject:name}}]({{schema:@VideoObject:embedUrl|replace:\"embed/\":\"watch?v=\"}})\n\n## Description\n\n{{schema:@VideoObject:description}}\n\n## Notes\n\n\n\n## Transcript\n\n{{transcript}}",
	"properties": [
		{
			"name": "title",
			"value": "{{schema:@VideoObject:name}}",
			"type": "text"
		},
		{
			"name": "source",
			"value": "{{schema:@VideoObject:embedUrl|replace:\\\"embed/\\\":\\\"watch?v=\\\"}}",
			"type": "text"
		},
		{
			"name": "author",
			"value": "{{schema:@VideoObject:author|wikilink}}",
			"type": "multitext"
		},
		{
			"name": "published",
			"value": "{{schema:@VideoObject:uploadDate|date:\\\"YYYY-MM-DD\\\"}}",
			"type": "date"
		},
		{
			"name": "created",
			"value": "{{date}}",
			"type": "date"
		},
		{
			"name": "image",
			"value": "{{schema:@VideoObject:thumbnailUrl|first}}",
			"type": "text"
		},
		{
			"name": "duration",
			"value": "{{schema:@VideoObject:duration|replace:\\\"PT\\\":\\\"\\\":\\\"S\\\",\\\"\\\"|duration}}",
			"type": "text"
		},
		{
			"name": "tags",
			"value": "source/video",
			"type": "multitext"
		}
	],
	"triggers": [
		"https://www.youtube.com/watch"
	],
	"noteNameFormat": "YT - {{schema:@VideoObject:name|safe_name|trim}}",
	"path": "01 Knowledge/Notes/Sources"
}
