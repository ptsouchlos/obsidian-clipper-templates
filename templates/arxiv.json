{
	"schemaVersion": "0.1.0",
	"name": "arXiv",
	"behavior": "create",
	"noteNameFormat": "CLIP - {{title}}",
	"path": "00 +Clippings",
	"noteContentFormat": "# Highlights \n\n> \n\n# Content\n\n{{content}}",
	"properties": [
		{
			"name": "title",
			"value": "{{title}}",
			"type": "text"
		},
		{
			"name": "source",
			"value": "{{url}}",
			"type": "text"
		},
		{
			"name": "author",
			"value": "{{selector:.ltx_authors .ltx_personname|wikilink|join}}",
			"type": "multitext"
		},
		{
			"name": "published",
			"value": "{{selector:.ltx_dates|replace:\\\"(\\\",\\\"\\\"|replace:\\\")\\\",\\\"\\\"|date:\\\"YYYY-MM-DD\\\"}}",
			"type": "date"
		},
		{
			"name": "created",
			"value": "{{date}}",
			"type": "date"
		},
		{
			"name": "description",
			"value": "{{description}}",
			"type": "text"
		},
		{
			"name": "tags",
			"value": "clippings, reference/article, status/unread",
			"type": "multitext"
		}
	],
	"triggers": [
		"https://arxiv.org/html/"
	]
}
