{
	"schemaVersion": "0.1.0",
	"name": "The Hacker News",
	"behavior": "create",
	"noteContentFormat": "# Highlights \n\n> \n\n# Content\n\n{{selectorHtml:#articlebody|remove_html:(\".dog_two,.note-b\")|markdown}}",
	"properties": [
		{
			"name": "title",
			"value": "{{title}}",
			"type": "text"
		},
		{
			"name": "source",
			"value": "{{url}}",
			"type": "text"
		},
		{
			"name": "author",
			"value": "{{selector:.post-body > div[itemprop=\\\"author\\\"] > meta[itemprop=\\\"name\\\"]?content|split:\\\",\\\"|wikilink|join}}",
			"type": "multitext"
		},
		{
			"name": "published",
			"value": "{{selectorHtml:.post-body > meta[itemprop=\\\"datePublished\\\"]?content|date:\\\"YYYY-MM-DD\\\"}}",
			"type": "date"
		},
		{
			"name": "created",
			"value": "{{date}}",
			"type": "date"
		},
		{
			"name": "description",
			"value": "{{description}}",
			"type": "text"
		},
		{
			"name": "tags",
			"value": "clippings, reference/article, status/unread",
			"type": "multitext"
		}
	],
	"triggers": [
		"https://thehackernews.com/"
	],
	"noteNameFormat": "CLIP - {{title}}",
	"path": "00 +Clippings"
}
